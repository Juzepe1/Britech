<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="project_project_search_inherit_stau" model="ir.ui.view">
    <field name="name">project.project.search.inherit.stau</field>
    <field name="model">project.project</field>
    <field name="mode">extension</field>
    <field name="priority">50</field>
    <field name="inherit_id" ref="project.view_project_project_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='my_projects']" position="after">
        <filter string="Stauner Templates" name="stau_is_template" domain="[('stau_is_template','=',True)]"/>
      </xpath>
    </field>
  </record>
</odoo>

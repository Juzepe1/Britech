
<odoo>
  <record id="view_mrp_bom_import_list" model="ir.ui.view">
    <field name="name">mrp.bom.import.list</field>
    <field name="model">mrp.bom.import</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="state"/>
        <field name="product_tmpl_id"/>
        <field name="existing_bom_id"/>
        <field name="create_date"/>
      </list>
    </field>
  </record>

  <record id="view_mrp_bom_import_form" model="ir.ui.view">
    <field name="name">mrp.bom.import.form</field>
    <field name="model">mrp.bom.import</field>
    <field name="arch" type="xml">
      <form string="BOM Import Assistant">
        <sheet>
          <header>
            <button name="action_parse_file" string="Parse File" type="object" class="btn-primary" invisible="state == 'done'"/>
            <button name="action_auto_match" string="Auto Match" type="object" invisible="state == 'done'"/>
            <button name="action_finalize" string="Finalize Import" type="object" class="btn-primary" invisible="state == 'done'"/>
            <field name="state"
               widget="statusbar"
               statusbar_visible="no,active,archived"
               readonly="1"
               class="oe_inline"
            />
             <button name="action_reset_to_draft"
            type="object"
            string="Reset to Draft"
            class="btn-secondary"
            icon="fa-undo"
            invisible="state == 'draft'"/>
          </header>

          <group>
            <group string="Import Source">
              <field name="file_type"/>
              <field name="delimiter" invisible="file_type != 'csv'"/>
              <field name="file_data" filename="filename"/>
              
<field name="source_mode"/>

<field name="document_id"  domain="[('res_model', '=', 'product.template'), ('res_id', '=', product_tmpl_id)]"
       invisible="source_mode != 'document'"/>
<field name="attachment_id"
       invisible="source_mode != 'document'"/>

<button name="action_load_from_document"
        type="object"
        string="Load from Document"
        class="btn-secondary"
        invisible="source_mode != 'document'"/>

<field name="filename" readonly="1"/>
            </group>
            <group string="Target">
              <field name="bom_target_mode"/>
              <field name="product_tmpl_id"/>
              <field name="existing_bom_id" domain="[('product_tmpl_id', '=', product_tmpl_id)]"/>/>
              <field name="product_uom_id"/>
              <field name="default_vendor_id" options="{'no_create_edit': True}"/>
              <field name="default_vendor_delay"/>
            </group>
            <group string="Matching">
              <field name="match_field_key"/>
            </group>
          </group>

          <notebook>
            <page string="Lines">
              <field name="line_ids" context="{'default_import_id': id}">
                <list editable="bottom">
                  <field name="sequence"/>
                  <field name="status"/>
                  <field name="raw_part_number"/>
                  <field name="raw_description"/>
                  <field name="raw_quantity"/>
                  <field name="ptp_qty_onhand"/>
                  <field name="raw_footprint"/>
                  <field name="product_tmpl_id_ui" context="{'bom_import_show_labels': True}"/>
                  <field name="raw_bom_designator"/>
                  <field name="raw_bom_Time"/>
                  <button type="object" name="action_show_line" string="Zobraz"/>
                  <button type="object" name="action_create_new_from_template" string="Create New"/>
                  <field name="resolution_done"/>
                </list>
                <form>
                  <group>
                    <group>
                      <field name="raw_part_number"/>
                      <field name="raw_description"/>
                      <field name="raw_footprint"/>
                      <field name="product_tmpl_id_ui" context="{'bom_import_show_labels': True}"/>
                      <field name="status"/>
                      <field name="resolution_done"/>
                    </group>
                    <group>
                      <field name="raw_bom_designator"/>
                      <field name="raw_bom_Time"/>
                      <field name="create_from_template_id"/>
                      <field name="created_product_id" readonly="1"/>
                      <button type="object" name="action_show_line" string="Zobraz"/>
                      <button type="object" name="action_create_new_from_template" string="Create New"/>
                    </group>
                  </group>
                  <notebook>
                    <page string="Steps">
                      <field name="step_log_ids" context="{'default_line_id': id}" views="{'list': 'mrp_bom_import_assistant.view_mrp_bom_import_line_step_list'}"/>
                    </page>
                    <page string="Raw">
                      <field name="raw_data_json" widget="json"/>
                    </page>
                  </notebook>
                </form>
              </field>
            </page>
          </notebook>

          <group>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_mrp_bom_import" model="ir.actions.act_window">
    <field name="name">BOM Imports</field>
    <field name="res_model">mrp.bom.import</field>
    <field name="view_mode">list,form</field>
    <field name="context">{}</field>
  </record>

  <menuitem id="menu_mrp_bom_import_root" name="BOM Imports" parent="mrp.menu_mrp_root" sequence="95" action="action_mrp_bom_import"/>

  <record id="view_mrp_bom_import_line_step_list" model="ir.ui.view">
    <field name="name">mrp.bom.import.line.step.list</field>
    <field name="model">mrp.bom.import.line.step</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="message"/>
        <field name="user_id"/>
        <field name="date"/>
      </list>
    </field>
  </record>
</odoo>
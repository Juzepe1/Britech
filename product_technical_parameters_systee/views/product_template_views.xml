<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ptp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_qr_codes"
                        type="object"
                        string="Generovat QR kódy"
                        class="btn-primary"
                        icon="fa-qrcode"
                        invisible="qr_code"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="ptp_value_unit_combined" readonly="1"/>
                <field name="qr_code" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Technical Parameters"
                      invisible="not ptp_category_type_related">
                    <group>
                        <field name="ptp_category_type_related" readonly="1"/>
                        <field name="ptp_part_number"/>
                        <field name="ptp_footprint"/>
                        <field name="ptp_note"/>
                        <field name="ptp_value_unit_combined" readonly="1"/>
                        <field name="qr_code" widget="image" class="oe_avatar"/>
                    </group>

                    <xpath expr="." position="inside">
                        <template id="ptp_dynamic_groups" inherit_id="base.view_partner_form">
                            <xpath expr="/form/sheet/group" position="inside">
                                <t t-foreach="fields_get().keys()" t-as="f">
                                    <t t-if="f.startswith('ptp_') and not f in ['ptp_part_number', 'ptp_footprint', 'ptp_note', 'ptp_value_unit_combined', 'qr_code']">
                                        <field name="[[ f ]]" attrs="{'invisible': [('ptp_category_type_related','!=', f.split('_')[1])]}"/>
                                    </t>
                                </t>
                            </xpath>
                        </template>
                    </xpath>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
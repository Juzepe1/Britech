<?xml version='1.0' encoding='UTF-8'?>
<odoo>
	<record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ptp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_qr_codes" type="object" string="Generovat QR kódy" class="btn-primary" icon="fa-qrcode" invisible="qr_code"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="ptp_value_unit_combined" readonly="1"/>
                <field name="qr_code" widget="image" class="oe_avatar"/>
            </xpath>
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Technical Parameters" invisible="not ptp_category_type_related">>
          <group string="Antény" invisible="ptp_category_type_related != 'ant'"/>
          <group string="Baterie a články" invisible="ptp_category_type_related != 'bat'">
            <field name="ptp_bat_typ"/>
            <field name="ptp_bat_napeti_value"/>
            <field name="ptp_bat_napeti_unit"/>
            <field name="ptp_bat_kapacita_value"/>
            <field name="ptp_bat_kapacita_unit"/>
            <field name="ptp_bat_chemie"/>
          </group>
          <group string="Bipolární tranzistory" invisible="ptp_category_type_related != 'bip'">
            <field name="ptp_bip_typ"/>
            <field name="ptp_bip_napeti_uce_value"/>
            <field name="ptp_bip_napeti_uce_unit"/>
            <field name="ptp_bip_proud_ice_value"/>
            <field name="ptp_bip_proud_ice_unit"/>
          </group>
          <group string="Bluetooth a wifi" invisible="ptp_category_type_related != 'blu'">
            <field name="ptp_blu_typ"/>
          </group>
          <group string="Kondenzátory" invisible="ptp_category_type_related != 'cap'">
            <field name="ptp_cap_value"/>
            <field name="ptp_cap_unit"/>
            <field name="ptp_cap_voltage_rating"/>
            <field name="ptp_cap_dielectric"/>
            <field name="ptp_cap_tolerance"/>
          </group>
          <group string="Chladiče" invisible="ptp_category_type_related != 'chl'">
            <field name="ptp_chl_rozmery"/>
            <field name="ptp_chl_material"/>
          </group>
          <group string="Diody" invisible="ptp_category_type_related != 'dio'">
            <field name="ptp_dio_typ"/>
            <field name="ptp_dio_napeti_value"/>
            <field name="ptp_dio_napeti_unit"/>
            <field name="ptp_dio_proud_value"/>
            <field name="ptp_dio_proud_unit"/>
          </group>
          <group string="Displeje" invisible="ptp_category_type_related != 'dis'">
            <field name="ptp_dis_typ"/>
          </group>
          <group string="Desky plošných spojů" invisible="ptp_category_type_related != 'dps'">
            <field name="ptp_dps_rozmery_value"/>
            <field name="ptp_dps_rozmery_unit"/>
            <field name="ptp_dps_pocet_vrstev_value"/>
            <field name="ptp_dps_pocet_vrstev_unit"/>
            <field name="ptp_dps_tloustka_value"/>
            <field name="ptp_dps_tloustka_unit"/>
            <field name="ptp_dps_povrchova_uprava"/>
            <field name="ptp_dps_material"/>
          </group>
          <group string="Držáky baterií" invisible="ptp_category_type_related != 'drb'">
            <field name="ptp_drb_typ_baterie"/>
            <field name="ptp_drb_pocet_clanku_value"/>
            <field name="ptp_drb_pocet_clanku_unit"/>
            <field name="ptp_drb_montaz"/>
          </group>
          <group string="Držáky pojistek" invisible="ptp_category_type_related != 'drp'">
            <field name="ptp_drp_typ_pojistky"/>
            <field name="ptp_drp_montaz"/>
          </group>
          <group string="HDD/SSD" invisible="ptp_category_type_related != 'hdd'">
            <field name="ptp_hdd_typ"/>
            <field name="ptp_hdd_kapacita"/>
            <field name="ptp_hdd_kapacita_unit"/>
          </group>
          <group string="Feritové perličky" invisible="ptp_category_type_related != 'imp'">
            <field name="ptp_imp_value"/>
            <field name="ptp_imp_unit"/>
          </group>
          <group string="Induktory" invisible="ptp_category_type_related != 'ind'">
            <field name="ptp_ind_value"/>
            <field name="ptp_ind_unit"/>
          </group>
          <group string="Integrované obvody" invisible="ptp_category_type_related != 'int'">
            <field name="ptp_int_typ"/>
            <field name="ptp_int_funkce"/>
          </group>
          <group string="Laserové diody" invisible="ptp_category_type_related != 'lad'">
            <field name="ptp_lad_vlnova_delka_value"/>
            <field name="ptp_lad_vlnova_delka_unit"/>
            <field name="ptp_lad_proud_value"/>
            <field name="ptp_lad_proud_unit"/>
            <field name="ptp_lad_napeti_value"/>
            <field name="ptp_lad_napeti_unit"/>
          </group>
          <group string="LED diody" invisible="ptp_category_type_related != 'led'">
            <field name="ptp_led_barva"/>

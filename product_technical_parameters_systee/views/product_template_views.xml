          </group>
          <group string="Schottkyho diody" invisible="ptp_category_type_related != 'sch'">
            <field name="ptp_sch_ifpropustny_proud_value"/>
            <field name="ptp_sch_ifpropustny_proud_unit"/>
            <field name="ptp_sch_vrrm_value"/>
            <field name="ptp_sch_vrrm_unit"/>
          </group>
          <group string="Senzory" invisible="ptp_category_type_related != 'sen'">
            <field name="ptp_sen_merena_velicina"/>
            <field name="ptp_sen_typ_vystupu"/>
          </group>
          <group string="Tlačítka a přepínače" invisible="ptp_category_type_related != 'tla'">
            <field name="ptp_tla_typ"/>
            <field name="ptp_tla_pocet_poloh_value"/>
            <field name="ptp_tla_pocet_poloh_unit"/>
            <field name="ptp_tla_montaz"/>
          </group>
          <group string="TVS diody" invisible="ptp_category_type_related != 'tvs'">
            <field name="ptp_tvs_napeti_value"/>
            <field name="ptp_tvs_napeti_unit"/>
            <field name="ptp_tvs_proud_value"/>
            <field name="ptp_tvs_proud_unit"/>
            <field name="ptp_tvs_typ"/>
            <field name="ptp_tvs_polarity"/>
            <field name="ptp_tvs_chanel"/>
          </group>
          <group string="Tyristory" invisible="ptp_category_type_related != 'tyr'">
            <field name="ptp_tyr_napeti_value"/>
            <field name="ptp_tyr_napeti_unit"/>
            <field name="ptp_tyr_proud_value"/>
            <field name="ptp_tyr_proud_unit"/>
          </group>
          <group string="Unipolární tranzistory" invisible="ptp_category_type_related != 'uni'">
            <field name="ptp_uni_typ_value"/>
            <field name="ptp_uni_napeti_vds_value"/>
            <field name="ptp_uni_napeti_vds_unit"/>
            <field name="ptp_uni_proud_ids_value"/>
            <field name="ptp_uni_proud_ids_unit"/>
          </group>
          <group string="USB konektory" invisible="ptp_category_type_related != 'usb'">
            <field name="ptp_usb_typ"/>
          </group>
          <group string="Usměrňovací diody" invisible="ptp_category_type_related != 'usm'">
            <field name="ptp_usm_if_value"/>
            <field name="ptp_usm_if_unit"/>
            <field name="ptp_usm_vr_value"/>
            <field name="ptp_usm_vr_unit"/>
          </group>
          <group string="Varistory" invisible="ptp_category_type_related != 'var'">
            <field name="ptp_var_napeti_value"/>
            <field name="ptp_var_napeti_unit"/>
            <field name="ptp_var_proud_value"/>
            <field name="ptp_var_proud_unit"/>
          </group>
          <group string="Zásuvky a zástrčky" invisible="ptp_category_type_related != 'zas'">
            <field name="ptp_zas_typ_konektoru"/>
            <field name="ptp_zas_pocet_pinu_value"/>
            <field name="ptp_zas_pocet_pinu_unit"/>
            <field name="ptp_zas_montaz"/>
          </group>
          <group string="Zenerovy diody" invisible="ptp_category_type_related != 'zen'">
            <field name="ptp_zen_vz_value"/>
            <field name="ptp_zen_vz_unit"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>

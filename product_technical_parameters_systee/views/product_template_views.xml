            <field name="ptp_led_proud_unit"/>
            <field name="ptp_led_napeti_value"/>
            <field name="ptp_led_napeti_unit"/>
          </group>
          <group string="Maskovací pásky" invisible="ptp_category_type_related != 'mas'">
            <field name="ptp_mas_sirka_value"/>
            <field name="ptp_mas_sirka_unit"/>
            <field name="ptp_mas_material"/>
          </group>
          <group string="Napájecí konektory" invisible="ptp_category_type_related != 'nap'">
            <field name="ptp_nap_typ_konektoru"/>
            <field name="ptp_nap_pocet_pinu_value"/>
            <field name="ptp_nap_pocet_pinu_unit"/>
            <field name="ptp_nap_montaz"/>
            <field name="ptp_nap_roztec_kontaktu_value"/>
            <field name="ptp_nap_roztec_kontaktu_unit"/>
          </group>
          <group string="Ostatní" invisible="ptp_category_type_related != 'oth'"/>
          <group string="Pájecí pasty a tavidla" invisible="ptp_category_type_related != 'pas'">
            <field name="ptp_pas_typ_value"/>
            <field name="ptp_pas_slozeni"/>
          </group>
          <group string="Pinové lišty" invisible="ptp_category_type_related != 'pin'">
            <field name="ptp_pin_roztec_kontaktu_value"/>
            <field name="ptp_pin_roztec_kontaktu_unit"/>
            <field name="ptp_pin_typ"/>
            <field name="ptp_pin_pocet_pinu_value"/>
            <field name="ptp_pin_pocet_pinu_unit"/>
            <field name="ptp_pin_montaz"/>
          </group>
          <group string="PLC prvky" invisible="ptp_category_type_related != 'plc'">
            <field name="ptp_plc_typ"/>
          </group>
          <group string="Pojistky" invisible="ptp_category_type_related != 'poj'">
            <field name="ptp_poj_proud_value"/>
            <field name="ptp_poj_proud_unit"/>
            <field name="ptp_poj_napeti_value"/>
            <field name="ptp_poj_napeti_unit"/>

<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ptp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_qr_codes"
                        type="object"
                        string="Generovat QR kódy"
                        class="btn-primary"
                        icon="fa-qrcode"
                        invisible="qr_code"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="ptp_value_unit_combined" readonly="1"/>
                <field name="qr_code" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Technical Parameters" invisible="not ptp_category_type_related">
                    <group>
                        <field name="ptp_category_type_related" readonly="1"/>
                        <field name="ptp_part_number"/>
                        <field name="ptp_footprint"/>
                        <field name="ptp_note"/>
                        <field name="qr_code" widget="image" class="oe_avatar"/>
                    </group>

                    <!-- Group blocks for all known types -->
                    <group string="BLU Fields" invisible="ptp_category_type_related != 'blu'">
                        <field name="ptp_blu_typ"/>
                    </group>
                    <group string="DIS Fields" invisible="ptp_category_type_related != 'dis'">
                        <field name="ptp_dis_typ"/>
                    </group>
                    <group string="PLC Fields" invisible="ptp_category_type_related != 'plc'">
                        <field name="ptp_plc_typ"/>
                    </group>
                    <group string="HDD Fields" invisible="ptp_category_type_related != 'hdd'">
                        <field name="ptp_hdd_typ"/>
                        <field name="ptp_hdd_kapacita"/>
                        <field name="ptp_hdd_kapacita_unit"/>
                    </group>
                    <group string="SEN Fields" invisible="ptp_category_type_related != 'sen'">
                        <field name="ptp_sen_merena_velicina"/>
                        <field name="ptp_sen_typ_vystupu"/>
                    </group>
                    <group string="BAT Fields" invisible="ptp_category_type_related != 'bat'">
                        <field name="ptp_bat_typ"/>
                        <field name="ptp_bat_napeti_value"/>
                        <field name="ptp_bat_napeti_unit"/>
                        <field name="ptp_bat_kapacita_value"/>
                        <field name="ptp_bat_kapacita_unit"/>
                        <field name="ptp_bat_chemie"/>
                    </group>
                    <group string="POJ Fields" invisible="ptp_category_type_related != 'poj'">
                        <field name="ptp_poj_proud_value"/>
                        <field name="ptp_poj_proud_unit"/>
                        <field name="ptp_poj_napeti_value"/>
                        <field name="ptp_poj_napeti_unit"/>
                        <field name="ptp_poj_typ"/>
                        <field name="ptp_poj_typ_pojistky"/>
                    </group>
                    <group string="TVS Fields" invisible="ptp_category_type_related != 'tvs'">
                        <field name="ptp_tvs_napeti_value"/>
                        <field name="ptp_tvs_napeti_unit"/>
                        <field name="ptp_tvs_proud_value"/>
                        <field name="ptp_tvs_proud_unit"/>
                        <field name="ptp_tvs_typ"/>
                        <field name="ptp_tvs_polarity"/>
                        <field name="ptp_tvs_chanel"/>
                    </group>
                    <group string="VAR Fields" invisible="ptp_category_type_related != 'var'">
                        <field name="ptp_var_napeti_value"/>
                        <field name="ptp_var_napeti_unit"/>
                        <field name="ptp_var_proud_value"/>
                        <field name="ptp_var_proud_unit"/>
                    </group>
                    <group string="LAD Fields" invisible="ptp_category_type_related != 'lad'">
                        <field name="ptp_lad_vlnova_delka_value"/>
                        <field name="ptp_lad_vlnova_delka_unit"/>
                        <field name="ptp_lad_proud_value"/>
                        <field name="ptp_lad_proud_unit"/>
                        <field name="ptp_lad_napeti_value"/>
                        <field name="ptp_lad_napeti_unit"/>
                    </group>
                    <group string="DIO Fields" invisible="ptp_category_type_related != 'dio'">
                        <field name="ptp_dio_typ"/>
                        <field name="ptp_dio_napeti_value"/>
                        <field name="ptp_dio_napeti_unit"/>
                        <field name="ptp_dio_proud_value"/>
                        <field name="ptp_dio_proud_unit"/>
                    </group>
                    <group string="SCH Fields" invisible="ptp_category_type_related != 'sch'">
                        <field name="ptp_sch_ifpropustny_proud_value"/>
                        <field name="ptp_sch_ifpropustny_proud_unit"/>
                        <field name="ptp_sch_vrrm_value"/>
                        <field name="ptp_sch_vrrm_unit"/>
                    </group>
                    <group string="ZEN Fields" invisible="ptp_category_type_related != 'zen'">
                        <field name="ptp_zen_vz_value"/>
                        <field name="ptp_zen_vz_unit"/>
                    </group>
                    <group string="TYR Fields" invisible="ptp_category_type_related != 'tyr'">
                        <field name="ptp_tyr_napeti_value"/>
                        <field name="ptp_tyr_napeti_unit"/>
                        <field name="ptp_tyr_proud_value"/>
                        <field name="ptp_tyr_proud_unit"/>
                    </group>
                    <group string="BIP Fields" invisible="ptp_category_type_related != 'bip'">
                        <field name="ptp_bip_typ"/>
                        <field name="ptp_bip_napeti_uce_value"/>
                        <field name="ptp_bip_napeti_uce_unit"/>
                        <field name="ptp_bip_proud_ice_value"/>
                        <field name="ptp_bip_proud_ice_unit"/>
                    </group>
                    <group string="UNI Fields" invisible="ptp_category_type_related != 'uni'">
                        <field name="ptp_uni_typ_value"/>
                        <field name="ptp_uni_napeti_vds_value"/>
                        <field name="ptp_uni_napeti_vds_unit"/>
                        <field name="ptp_uni_proud_ids_value"/>
                        <field name="ptp_uni_proud_ids_unit"/>
                    </group>
                    <group string="MAS Fields" invisible="ptp_category_type_related != 'mas'">
                        <field name="ptp_mas_sirka_value"/>
                        <field name="ptp_mas_sirka_unit"/>
                        <field name="ptp_mas_material"/>
                    </group>
                    <group string="PAS Fields" invisible="ptp_category_type_related != 'pas'">
                        <field name="ptp_pas_typ_value"/>
                        <field name="ptp_pas_slozeni"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
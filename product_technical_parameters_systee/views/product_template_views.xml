<odoo>
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ptp</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_generate_qr_codes"
                        type="object"
                        string="Generovat QR kódy"
                        class="btn-primary"
                        icon="fa-qrcode"/>
            </xpath>
            <xpath expr="//field[@name='categ_id']" position="after">
                    <field name="ptp_value_unit_combined" readonly="1"/>
                    <field name="qr_code" widget="image" class="oe_avatar"/>
                <field name="valid_product_template_attribute_line_ids" invisible="1"/>
                <field name="barcode" invisible="product_variant_count &gt; 1                         
        or (product_variant_count == 0                         
        and valid_product_template_attribute_line_ids)                         
        or type in ['service', 'combo']"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">

                <!-- Nová záložka "Technical Parameters" -->
                <page string="Technical Parameters"
                      invisible="not ptp_category_type_related">
                    <!--
                      Tato záložka se skryje, pokud 
                      ptp_category_type_related je prázdné (False).
                    -->

                    <group>
                        <field name="ptp_category_type_related" readonly="1"/>

                        <field name="ptp_part_number"/>
                        <field name="ptp_footprint"/>
                        <field name="ptp_note"/>
                        <field name="ptp_value_unit_combined" readonly="1"/>
                        <field name="qr_code" widget="image" class="oe_avatar" />
                    </group>

                    <!-- Skupina pro kondenzátor -->
                    <group string="Capacitor Fields"
                           invisible="ptp_category_type_related != 'capacitor'">
                        <field name="ptp_cap_value"/>
                        <field name="ptp_cap_unit"/>
                        <field name="ptp_cap_voltage_rating"/>
                        <field name="ptp_cap_dielectric"/>
                        <field name="ptp_cap_tolerance"/>
                    </group>

                    <!-- Skupina pro rezistor -->
                    <group string="Resistor Fields"
                           invisible="ptp_category_type_related != 'resistor'">
                        <field name="ptp_res_value"/>
                        <field name="ptp_res_unit"/>
                        <field name="ptp_res_power_rating"/>
                        <field name="ptp_res_tolerance"/>
                        <field name="ptp_res_voltage_rating"/>
                    </group>

                    <!-- Skupina pro Feritové perličky -->
                    <group string="Fereite Fields"
                           invisible="ptp_category_type_related != 'ferrite_bead'">
                        <field name="ptp_imp_value"/>
                        <field name="ptp_imp_unit"/>
                    </group>

                    <!-- Skupina pro Indukctory -->
                    <group string="Inductor Fields"
                           invisible="ptp_category_type_related != 'inductor'">
                        <field name="ptp_ind_value"/>
                        <field name="ptp_ind_unit"/>
                    </group>

                    <!-- Skupina pro Tranzistory -->
                    <group string="Transistor Fields"
                           invisible="ptp_category_type_related != 'transistor'">
                        <field name="ptp_tran_polarity"/>
                        <field name="ptp_tran_type"/>
                    </group>

                    <!-- Skupina pro TVS diody -->
                    <group string="TVS diode Fields"
                           invisible="ptp_category_type_related != 'tvs_diode'">
                        <field name="ptp_tvs_polarity"/>
                        <field name="ptp_tvs_chanel"/>
                    </group>

                    <!-- Skupina pro LED -->
                    <group string="LED Fields"
                           invisible="ptp_category_type_related != 'led'">
                        <field name="ptp_led_color"/>
                    </group>
                </page>

            </xpath>
        </field>
    </record>
</odoo>
